#!/usr/bin/env python3
"""stdio MCP wrapper for marc-hub in Forge Cloud workspaces.

Answers initialize and tools/list at once from marc-hub-tools.json (so the session starts fast), and forwards
tools/call to the marc-hub HTTP server that forge-orch tunnels into this workspace on 127.0.0.1:18766.
Auth is the workspace's own Okta identity token (~/.canva/identity-token); nothing secret lives here.
"""
import json, os, socket, sys, time, urllib.request

PORT = int(os.environ.get("MARC_HUB_PORT", "18766"))
URL = f"http://127.0.0.1:{PORT}/mcp"
WAIT_S = float(os.environ.get("MARC_HUB_WAIT", "120"))
HERE = os.path.dirname(os.path.realpath(__file__))
SPEC = json.load(open(os.path.join(HERE, "marc-hub-tools.json")))


def thread_id():
    h = socket.gethostname()
    return h[len("forge-"):] if h.startswith("forge-") else h


def headers():
    h = {"content-type": "application/json", "X-Hub-Thread": thread_id()}
    if os.environ.get("HUB_ROLE"):
        h["X-Hub-Role"] = os.environ["HUB_ROLE"]
    try:
        tok = open(os.path.expanduser(os.environ.get("CANVA_IDENTITY_TOKEN_FILE", "~/.canva/identity-token"))).read().strip()
        h["Authorization"] = "Bearer " + tok
    except OSError:
        pass
    return h


def port_up():
    try:
        with socket.create_connection(("127.0.0.1", PORT), timeout=1):
            return True
    except OSError:
        return False


def forward(msg):
    deadline = time.time() + WAIT_S
    while not port_up():
        if time.time() > deadline:
            return {"jsonrpc": "2.0", "id": msg.get("id"), "result": {"isError": True, "content": [{"type": "text",
                    "text": "marc-hub isn't connected to this workspace yet (forge-orch attaches threads within a "
                            "minute). Try again shortly; if it keeps failing, tell Marc the hub tunnel is down."}]}}
        time.sleep(1)
    req = urllib.request.Request(URL, data=json.dumps(msg).encode(), headers=headers(), method="POST")
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            return json.load(r)
    except Exception as e:  # noqa: BLE001
        return {"jsonrpc": "2.0", "id": msg.get("id"), "result": {"isError": True,
                "content": [{"type": "text", "text": f"marc-hub call failed: {type(e).__name__}: {e}"}]}}


def handle(msg):
    m, mid = msg.get("method"), msg.get("id")
    if m == "initialize":
        pv = (msg.get("params") or {}).get("protocolVersion") or "2025-06-18"
        return {"jsonrpc": "2.0", "id": mid, "result": {"protocolVersion": pv, "capabilities": {"tools": {}},
                "serverInfo": SPEC["serverInfo"], "instructions": SPEC.get("instructions", "")}}
    if m == "tools/list":
        return {"jsonrpc": "2.0", "id": mid, "result": {"tools": SPEC["tools"]}}
    if m == "tools/call":
        return forward(msg)
    if m == "ping":
        return {"jsonrpc": "2.0", "id": mid, "result": {}}
    if mid is None:
        return None  # notification
    return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {m}"}}


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        out = handle(msg)
        if out is not None:
            sys.stdout.write(json.dumps(out) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
